{
  "Jwt": {
    "Key": "6d370dda243b06afa96eed7593a74c911a483f33ed139b7de5a70e3bbb9c84d3",
    "Issuer": "Ecommerce.Identity",
    "Audience": "Ecommerce.Services"
  },

  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },

      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },

      "products-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        }
      },

      "categories-route": {
        "ClusterId": "product-cluster",
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}"
        }
      },

      "cart-route": {
        "ClusterId": "cart-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/cart/{**catch-all}"
        }
      },

      "orders-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://localhost:5202"
          }
        }
      },

      "product-cluster": {
        "Destinations": {
          "product": {
            "Address": "http://localhost:5290"
          }
        }
      },

      "cart-cluster": {
        "Destinations": {
          "cart": {
            "Address": "http://localhost:5233"
          }
        }
      },

      "order-cluster": {
        "Destinations": {
          "order": {
            "Address": "http://localhost:5080"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}